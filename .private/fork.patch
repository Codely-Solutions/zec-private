-        pinnedSource.trim().isNotEmpty() &&
-        !pinnedSource.trim().isInvalidPinnedSource()
-
-private fun String.isInvalidPinnedSource(): Boolean =
-    isNotBlank() && runCatching { PinnedConfigSource.parse(this) }.isFailure
