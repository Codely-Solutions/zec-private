-    private fun buildProposalState(
-        proposal: Proposal,
-        tally: TallyResults,
-        recovery: VotingRecoverySnapshot?,
-    ): VoteProposalResultState {
-        val tallyProposal = tally.proposals.firstOrNull { it.proposalId == proposal.id }
