@@ -0,0 +1,55 @@
+package co.electriccoin.zcash.ui.common.provider
+
+import cash.z.ecc.android.sdk.Synchronizer
+import io.ktor.client.engine.okhttp.OkHttp
+import io.mockk.coEvery
+import io.mockk.every
