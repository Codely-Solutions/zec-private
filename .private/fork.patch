+
+class RecoveryCopyGuardTest {
+    @Test
+    fun callbackCapturedWhileRevealedChecksCurrentHiddenState() {
+        var revealed = true
+        var copies = 0
+        val callback = {
+            copyRecoveryIfRevealed(revealed, { error("hidden secret must not be evaluated") }, { copies++ })
+        }
+        revealed = false
+        callback()
+        assertEquals(0, copies)
+    }
