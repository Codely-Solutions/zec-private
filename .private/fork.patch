-/** Layout mirroring the crate's `test_pir_layout()` (config/mod.rs tests): 19/12/7/4096. */
-private val PIR_LAYOUT_FIXTURE = VotingPirLayout(pirDepth = 19, tier0Layers = 12, tier1Layers = 7, polyLen = 4096)
