+++ b/ui-lib/src/test/java/co/electriccoin/zcash/ui/screen/donation/DonationPolicyTest.kt
@@ -0,0 +1,174 @@
+package co.electriccoin.zcash.ui.screen.donation
+
+import co.electriccoin.zcash.ui.common.model.zcash.DonationPolicy
+import cash.z.ecc.android.sdk.model.Memo
+import cash.z.ecc.android.sdk.model.Proposal
+import cash.z.ecc.android.sdk.model.WalletAddress
+import cash.z.ecc.android.sdk.model.Zatoshi
+import cash.z.ecc.android.sdk.model.ZecSend
+import cash.z.wallet.sdk.internal.ffi.ProposalOuterClass
+import cash.z.wallet.sdk.internal.ffi.ProposalOuterClass.ValuePool
+import io.mockk.every
+import io.mockk.mockk
+import org.junit.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+
+class DonationPolicyTest {
+    @Test
+    fun shieldedInputOutputAndChangeAreAccepted() {
+        for (pool in listOf(ValuePool.Sapling, ValuePool.Orchard, ValuePool.Ironwood)) {
+            DonationPolicy.requireShielded(proposal(step(pool)), send())
+        }
+    }
+
+    @Test
+    fun transparentAndUnknownInputsAreRejected() {
+        for (pool in listOf(ValuePool.Transparent, ValuePool.PoolNotSpecified)) {
+            reject(step().clearInputs().addInputs(input(pool)))
+        }
+        reject(step().clearInputs().addInputs(
+            ProposalOuterClass.ProposedInput.newBuilder().setReceivedOutput(
+                ProposalOuterClass.ReceivedOutput.newBuilder().setValuePoolValue(999).setValue(150_000)
+            )
+        ))
+    }
+
+    @Test
+    fun priorStepInputsAndMissingInputsAreRejected() {
+        reject(step().clearInputs())
+        reject(step().clearInputs().addInputs(
+            ProposalOuterClass.ProposedInput.newBuilder().setPriorStepOutput(
+                ProposalOuterClass.PriorStepOutput.newBuilder().setStepIndex(0).setPaymentIndex(0)
+            )
+        ))
+    }
+
+    @Test
+    fun transparentOrUnknownPaymentPoolIsRejected() {
+        for (pool in listOf(ValuePool.Transparent, ValuePool.PoolNotSpecified)) {
+            reject(step().clearPaymentOutputPools().addPaymentOutputPools(paymentPool(pool)))
+        }
+        reject(step().clearPaymentOutputPools().addPaymentOutputPools(
+            ProposalOuterClass.PaymentOutputPool.newBuilder().setValuePoolValue(999)
+        ))
+        reject(step().clearPaymentOutputPools())
+        reject(step().addPaymentOutputPools(paymentPool(ValuePool.Orchard)))
+    }
+
+    @Test
+    fun transparentUnknownAndEphemeralChangeAreRejected() {
+        for (pool in listOf(ValuePool.Transparent, ValuePool.PoolNotSpecified)) {
+            reject(step().setBalance(balance(pool)))
+        }
+        reject(step().setBalance(balance().clearProposedChange().addProposedChange(
+            ProposalOuterClass.ChangeValue.newBuilder().setValuePoolValue(999).setValue(40_000)
+        )))
+        reject(step().setBalance(balance().clearProposedChange().addProposedChange(
+            ProposalOuterClass.ChangeValue.newBuilder().setValuePool(ValuePool.Orchard)
+                .setValue(40_000).setIsEphemeral(true)
+        )))
+    }
+
+    @Test
+    fun shieldingMultipleStepsAndMissingStepsAreRejected() {
+        reject(step().setIsShielding(true))
+        assertFailsWith<IllegalArgumentException> { DonationPolicy.requireShielded(proposal(step(), step()), send()) }
+        assertFailsWith<IllegalArgumentException> { DonationPolicy.requireShielded(proposal(), send()) }
+    }
+
+    @Test
+    fun amountMismatchAndUnreviewedMemoAreRejected() {
+        reject(step().setBalance(balance().setFeeRequired(10_001)))
+        assertFailsWith<IllegalArgumentException> {
+            DonationPolicy.requireShielded(proposal(step()), send(amount = 99_999))
+        }
+        assertFailsWith<IllegalArgumentException> {
+            DonationPolicy.requireShielded(proposal(step()), send(memo = "identity"))
+        }
+    }
+
+    @Test
+    fun serializedPaymentMustMatchReviewWithoutExtraRecipients() {
+        reject(step().setTransactionRequest("zcash:${DonationPolicy.RECIPIENT}?amount=0.002"))
+        reject(step().setTransactionRequest("zcash:t1Rv4exT7bqhZqi2j7xz8bUHDMxwosrjADU?amount=0.001"))
+        reject(step().setTransactionRequest("zcash:${DonationPolicy.RECIPIENT}?amount=0.001&memo=aWRlbnRpdHk"))
+        reject(step().setTransactionRequest(
+            "zcash:${DonationPolicy.RECIPIENT}?amount=0.001&address.1=${DonationPolicy.RECIPIENT}&amount.1=0.001"
+        ))
+        assertFailsWith<org.zecdev.zip321.ZIP321.Errors.InvalidURI> {
+            DonationPolicy.requireShielded(proposal(step().setTransactionRequest("not a payment request")), send())
+        }
+        reject(step().clearPaymentOutputPools().addPaymentOutputPools(
+            paymentPool(ValuePool.Orchard).setPaymentIndex(1)
+        ))
+    }
+
+    @Test
+    fun reviewedUnicodeMemoIsAcceptedExactly() {
+        val reviewed = "Thanks 💚"
+        val encoded = java.util.Base64.getUrlEncoder().withoutPadding()
+            .encodeToString(reviewed.toByteArray(Charsets.UTF_8))
+        val matching = step().setTransactionRequest("zcash:${DonationPolicy.RECIPIENT}?amount=0.001&memo=$encoded")
+        DonationPolicy.requireShielded(proposal(matching), send(memo = reviewed))
+        assertFailsWith<IllegalArgumentException> {
+            DonationPolicy.requireShielded(proposal(matching), send(memo = "Thanks"))
+        }
+        assertFailsWith<IllegalArgumentException> {
+            DonationPolicy.requireShielded(proposal(matching), send())
+        }
+    }
+
+    @Test
+    fun paddedReviewedMemoIsAcceptedButAdditionalBytesAreRejected() {
+        val reviewed = "Support"
+        val bytes = reviewed.toByteArray(Charsets.UTF_8)
+        val encoder = java.util.Base64.getUrlEncoder().withoutPadding()
+        val padded = encoder.encodeToString(bytes.copyOf(512))
+        DonationPolicy.requireShielded(
+            proposal(step().setTransactionRequest("zcash:${DonationPolicy.RECIPIENT}?amount=0.001&memo=$padded")),
+            send(memo = reviewed)
+        )
+        val altered = bytes.copyOf(512).apply { this[511] = 1 }
+        assertFailsWith<IllegalArgumentException> {
+            DonationPolicy.requireShielded(
+                proposal(step().setTransactionRequest(
+                    "zcash:${DonationPolicy.RECIPIENT}?amount=0.001&memo=${encoder.encodeToString(altered)}"
+                )), send(memo = reviewed)
+            )
+        }
+    }
+
+    private fun reject(step: ProposalOuterClass.ProposalStep.Builder) {
+        assertFailsWith<IllegalArgumentException> { DonationPolicy.requireShielded(proposal(step), send()) }
+    }
+
+    private fun proposal(vararg steps: ProposalOuterClass.ProposalStep.Builder): Proposal {
+        val bytes = ProposalOuterClass.Proposal.newBuilder()
+            .setFeeRule(ProposalOuterClass.FeeRule.Zip317)
+            .addAllSteps(steps.map { it.build() }).build().toByteArray()
+        return mockk { every { toByteArray() } returns bytes }
+    }
+
+    private fun step(pool: ValuePool = ValuePool.Orchard) = ProposalOuterClass.ProposalStep.newBuilder()
+        .setTransactionRequest("zcash:${DonationPolicy.RECIPIENT}?amount=0.001")
+        .addInputs(input(pool)).addPaymentOutputPools(paymentPool(pool)).setBalance(balance(pool))
+
+    private fun input(pool: ValuePool) = ProposalOuterClass.ProposedInput.newBuilder().setReceivedOutput(
+        ProposalOuterClass.ReceivedOutput.newBuilder().setValuePool(pool).setValue(150_000)
+    )
+
+    private fun paymentPool(pool: ValuePool) = ProposalOuterClass.PaymentOutputPool.newBuilder().setValuePool(pool)
+
+    private fun balance(pool: ValuePool = ValuePool.Orchard) = ProposalOuterClass.TransactionBalance.newBuilder()
+        .setFeeRequired(10_000).addProposedChange(
+            ProposalOuterClass.ChangeValue.newBuilder().setValuePool(pool).setValue(40_000)
+        )
+
+    private fun send(amount: Long = 100_000, memo: String = "") = ZecSend(
+        destination = mockk<WalletAddress.Unified> { every { address } returns DonationPolicy.RECIPIENT },
+        amount = Zatoshi(amount),
+        memo = Memo(memo),
+        proposal = null
+    )
+}
diff --git a/ui-lib/src/test/java/co/electriccoin/zcash/ui/screen/donation/DonationPreferencesTest.kt b/ui-lib/src/test/java/co/electriccoin/zcash/ui/screen/donation/DonationPreferencesTest.kt
new file mode 100644
index 000000000..359f3acd3
--- /dev/null
+++ b/ui-lib/src/test/java/co/electriccoin/zcash/ui/screen/donation/DonationPreferencesTest.kt
@@ -0,0 +1,129 @@
+package co.electriccoin.zcash.ui.screen.donation
+
+import android.content.Context
+import co.electriccoin.zcash.ui.common.model.zcash.DonationPolicy
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+import org.junit.Before
+import org.junit.runner.RunWith
+import org.junit.Test
+import org.robolectric.annotation.Config
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class DonationPreferencesTest {
+    private val context: Context get() = RuntimeEnvironment.getApplication()
+
+    @Before
+    fun reset() {
+        context.getSharedPreferences("private_donation_suggestions", Context.MODE_PRIVATE).edit().clear().commit()
+    }
+
+    @Test
+    fun postponementPersistsAndExpiresAtCooldownBoundary() {
+        val now = 1_000_000L
+        assertTrue(DonationPreferences(context).mayInvite(now))
+        DonationPreferences(context).postpone(now)
+        val restored = DonationPreferences(context)
+        assertFalse(restored.mayInvite(now))
+        assertFalse(restored.mayInvite(now - 1))
+        assertFalse(restored.mayInvite(now + DonationPolicy.COOLDOWN_MILLIS - 1))
+        assertTrue(restored.mayInvite(now + DonationPolicy.COOLDOWN_MILLIS))
+    }
+
+    @Test
+    fun permanentDeclineSurvivesRecreationAndLaterPostponement() {
+        DonationPreferences(context).declinePermanently()
+        DonationPreferences(context).postpone(1_000_000)
+        assertFalse(DonationPreferences(context).mayInvite(1_000_000 + 10 * DonationPolicy.COOLDOWN_MILLIS))
+    }
+
+    @Test
+    fun introductionCanBeClaimedOnlyOnceAcrossRecreation() {
+        assertTrue(DonationPreferences(context).claimAutomaticIntroduction())
+        assertFalse(DonationPreferences(context).claimAutomaticIntroduction())
+    }
+
+    @Test
+    fun permanentDeclineAlsoSuppressesAutomaticIntroduction() {
+        DonationPreferences(context).declinePermanently()
+        assertFalse(DonationPreferences(context).claimAutomaticIntroduction())
+    }
+
+    @Test
+    fun homeEntrySnapshotWaitsForSuccessfulActivityOnALaterVisit() {
+        val preferences = DonationPreferences(context)
+        val entryEligibility = preferences.mayInviteOnHomeEntry(1_000_000)
+        preferences.recordSuccessfulTransaction()
+        assertFalse(entryEligibility)
+        assertTrue(DonationPreferences(context).mayInviteOnHomeEntry(1_000_000))
+    }
+
+    @Test
+    fun displayingInvitationStartsCooldownWithoutRequiringDismissal() {
+        val preferences = DonationPreferences(context)
+        preferences.recordSuccessfulTransaction()
+        preferences.recordInvitationDisplayed(1_000_000)
+        assertFalse(DonationPreferences(context).mayInviteOnHomeEntry(1_000_000))
+        assertTrue(preferences.mayInviteOnHomeEntry(1_000_000 + DonationPolicy.COOLDOWN_MILLIS))
+    }
+
+    @Test
+    fun replayedDonationHistoryDoesNotExtendCooldownOrQualifyActivity() {
+        val preferences = DonationPreferences(context)
+        val completedAt = 1_000_000L
+        preferences.recordDonationCompleted(completedAt, now = completedAt)
+        preferences.recordDonationCompleted(completedAt - 1, now = completedAt - 1)
+        preferences.recordDonationCompleted(completedAt, now = completedAt)
+        assertFalse(preferences.mayInvite(completedAt + DonationPolicy.COOLDOWN_MILLIS - 1))
+        assertTrue(preferences.mayInvite(completedAt + DonationPolicy.COOLDOWN_MILLIS))
+        assertFalse(preferences.mayInviteOnHomeEntry(completedAt + DonationPolicy.COOLDOWN_MILLIS))
+    }
+
+    @Test
+    fun historicalDonationCannotShortenRecentInvitationCooldown() {
+        val preferences = DonationPreferences(context)
+        preferences.recordInvitationDisplayed(2_000_000)
+        preferences.recordDonationCompleted(1_000_000, now = 1_000_000)
+        assertFalse(preferences.mayInvite(1_000_000 + DonationPolicy.COOLDOWN_MILLIS))
+    }
+
+    @Test
+    fun donationCooldownDefersIntroductionWithoutConsumingIt() {
+        val preferences = DonationPreferences(context)
+        preferences.recordDonationCompleted(1_000_000, now = 1_000_000)
+        assertFalse(preferences.claimAutomaticIntroduction(1_000_000))
+        assertTrue(preferences.claimAutomaticIntroduction(1_000_000 + DonationPolicy.COOLDOWN_MILLIS))
+        assertFalse(DonationPreferences(context).claimAutomaticIntroduction(1_000_000 + DonationPolicy.COOLDOWN_MILLIS))
+    }
+    @Test
+    fun confirmedDonationGetsFullCooldownFromObservationRatherThanMinedTime() {
+        val preferences = DonationPreferences(context)
+        preferences.recordDonationCompleted(1_000_000, now = 2_000_000)
+        assertFalse(preferences.mayInvite(2_000_000 + DonationPolicy.COOLDOWN_MILLIS - 1))
+        assertTrue(preferences.mayInvite(2_000_000 + DonationPolicy.COOLDOWN_MILLIS))
+        preferences.recordDonationCompleted(1_000_000, now = 3_000_000)
+        assertTrue(preferences.mayInvite(2_000_000 + DonationPolicy.COOLDOWN_MILLIS))
+    }
+
+    @Test
+    fun liveSuppressionObserverIgnoresDisplayAndReleasesWithItsOwner() {
+        val preferences = DonationPreferences(context)
+        var changes = 0
+        val release = preferences.observeSuppression { changes++ }
+        preferences.recordInvitationDisplayed(1_000_000)
+        org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle()
+        assertEquals(0, changes)
+        preferences.recordDonationCompleted(1_000_000, now = 2_000_000)
+        org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle()
+        assertEquals(1, changes)
+        release()
+        preferences.declinePermanently()
+        org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle()
+        assertEquals(1, changes)
+    }
+
+}
