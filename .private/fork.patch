-                            onClick = ::onConfirmSendFeedback
-                        ),
-                    dismissButtonState =
-                        ButtonState(
-                            text = stringRes(co.electriccoin.zcash.ui.design.R.string.general_cancel),
-                            onClick = { isDialogShown.update { false } }
-                        ),
-                    onDismissRequest = { isDialogShown.update { false } }
