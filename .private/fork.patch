-        pirEndpoints = listOf(VotingServiceConfig.ServiceEndpoint(url = "https://pir.example.com", label = "pir")),
-        pirLayout = pirLayout,
-        supportedVersions =
-            VotingServiceConfig.SupportedVersions(
