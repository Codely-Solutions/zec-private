-            title = stringRes(proposal.title),
-            description = stringRes(proposal.description),
-            options = options,
-            totalZec = stringRes(R.string.coinVote_results_total, totalWeight.toZec()),
-            votedLabel = proposal.votedResultLabel(recovery),
-        )
-    }
