+    @Test
+    fun revealedCopyPassesExactText() {
+        var copied = ""
+        copyRecoveryIfRevealed(true, { "fake phrase only" }, { copied = it })
+        assertEquals("fake phrase only", copied)
+        copyRecoveryIfRevealed(true, { "1234567" }, { copied = it })
+        assertEquals("1234567", copied)
+    }
+}
