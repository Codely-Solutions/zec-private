-private suspend fun <T> withTorRequestTimeoutFallback(
-    supportsKtorTimeouts: Boolean,
-    timeoutMillis: Long,
-    block: suspend () -> T
-): T =
-    if (supportsKtorTimeouts) {
-        block()
-    } else {
-        withTimeout(timeoutMillis) { block() }
